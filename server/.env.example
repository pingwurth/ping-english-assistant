# ── SOE 发音评分代理（契约②）──
# 评分实现：mock = 本地确定性伪评分（默认，无需密钥）；azure = Azure Pronunciation Assessment；
# tencent = 占位未实施（腾讯 SOE 基础版已停止迭代，见 docs/发音评分技术选型报告.md §5.2）
SOE_PROVIDER=mock

# Azure Speech（SOE_PROVIDER=azure 时必填；REGION/HOST 二选一）
# HOST 用于自定义域名资源（https://<资源名>.cognitiveservices.azure.com），否则用区域端点
AZURE_SPEECH_REGION=eastasia
# AZURE_SPEECH_HOST=
AZURE_SPEECH_KEY=

# 上游调用：超时与重试（报告 §6.1：超时 10s、重试 1 次）
SOE_TIMEOUT_MS=10000
SOE_RETRY=1

# ── 服务 ──
PORT=8788
HOST=0.0.0.0
# 前端来源，逗号分隔（Next dev 与局域网 H5 调试）
CORS_ORIGIN=http://localhost:3000
