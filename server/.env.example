# ── SOE 发音评分代理（契约②）──
# 评分实现：mock = 本地确定性伪评分（默认，无需密钥）；azure = Azure Pronunciation Assessment；
# tencent = 腾讯云口语评测（新版 OEN，WebSocket 接口）；iflytek = 科大讯飞 ISE 流式版
# 请求可带 multipart 字段 provider=mock|azure|tencent|iflytek 覆盖默认值（仅限已配置密钥的服务）
# 还可带 creds 字段（JSON，请求级密钥，优先于 env；如 {"azure":{"key":"...","region":"eastasia"}}）
SOE_PROVIDER=mock

# Azure Speech（SOE_PROVIDER=azure 时必填；REGION/HOST 二选一）
# HOST 用于自定义域名资源（https://<资源名>.cognitiveservices.azure.com），否则用区域端点
AZURE_SPEECH_REGION=eastasia
# AZURE_SPEECH_HOST=
AZURE_SPEECH_KEY=

# 腾讯云口语评测（新版/OEN）WebSocket 接口 wss://soe.cloud.tencent.com（SOE_PROVIDER=tencent 时三件全填）
# APPID = 腾讯云账号 AppID，见控制台「账号信息」页；SecretId/SecretKey = 访问管理 CAM → API 密钥管理
TENCENT_APP_ID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# 科大讯飞 ISE 流式版 wss://ise-api.xfyun.cn/v2/open-ise（SOE_PROVIDER=iflytek 时三件全填；
# 控制台创建「语音评测」应用后获得）
IFLYTEK_APP_ID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=
# 讯飞音频分帧发送间隔（官方建议 40ms/1280B；0 = 不等待）
IFLYTEK_FRAME_INTERVAL_MS=40

# 上游调用：超时与重试（报告 §6.1：超时 10s、重试 1 次）
SOE_TIMEOUT_MS=10000
SOE_RETRY=1

# ── 服务 ──
PORT=8788
# 默认仅监听回环（代理持有云密钥，不应裸露到局域网）。跨机部署需显式改成 0.0.0.0 并务必配置 SOE_SHARED_TOKEN
HOST=127.0.0.1
# 可选共享密钥：设置后 BFF 调用 evaluate 必须在 x-soe-token 头携带同值，否则 401（对外暴露时必配）。
# 未设置时代理仍会拒绝一切带 Origin/Sec-Fetch-Site 头的浏览器来源请求（本机 BFF 服务端转发不带这些头，
# 不受影响）——防止局域网页面无预检 multipart POST 盗用本服务保管的云密钥评分
# SOE_SHARED_TOKEN=
# 前端来源，逗号分隔（Next dev 与局域网 H5 调试）
CORS_ORIGIN=http://localhost:3000
