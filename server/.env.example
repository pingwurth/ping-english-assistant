# ---- 必需（缺失即拒启，zod 启动校验） ----
# 服务监听
PORT=3000
HOST=0.0.0.0

# OpenAI（Whisper ASR + GPT LLM）
OPENAI_API_KEY=
# 可选：OpenAI 兼容网关
OPENAI_BASE_URL=https://api.openai.com/v1

# 腾讯云智聆 SOE（Web/H5 端跟读评分后端代理）
TENCENT_SOE_SECRET_ID=
TENCENT_SOE_SECRET_KEY=

# ---- Provider 切换（降级矩阵，架构文档 §5.6） ----
# asr: whisper | xunfei
ASR_PROVIDER=whisper
# llm: openai | anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# tts: kokoro | azure
TTS_PROVIDER=kokoro

# ---- 可选 ----
# Anthropic（LLM_PROVIDER=anthropic 时必需）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# 讯飞 ASR（ASR_PROVIDER=xunfei 时必需）
XUNFEI_APP_ID=
XUNFEI_API_KEY=
XUNFEI_API_SECRET=

# CORS 白名单（H5 部署域名，逗号分隔；空 = 允许所有，仅开发用）
CORS_ORIGINS=

# 录音保留时长（小时）；0 = 即用即删（默认）
RECORDING_RETENTION_HOURS=0

# TTS 模型缓存目录（Kokoro-82M ONNX q8，首次启动自动下载）
KOKORO_MODEL_CACHE_DIR=./.cache/kokoro
